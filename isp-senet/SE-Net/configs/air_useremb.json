{
  "Data": {
    "name": "Air-D",
    "fix_path": "processed_data",
    "fixation_file_pattern": "AiR_fixations_{}.json",
    "task_embedding_path": "embeddings.npy",
    "image_path": "stimuli",
    "eval_split": "validation",
    "random_support": 0,
    "im_w": 512,
    "im_h": 320,
    "patch_num": [32, 20],
    "patch_size": [16, 16],
    "patch_count": 640,
    "fovea_radius": 2,
    "IOR_radius": 24,
    "max_traj_length": 20,
    "terminate_threshold": 0.75,
    "TAP": "QA",
    "stop_sampling_ratio": 0.5,
    "enforce_IOR": true,
    "has_stop": true,
    "use_action_map": false,
    "use_DCB_target": false,
    "sem_seq_dir": "semantic_seq_full/",
    "DCB_dir": "DCBs/HR/",
    "subject": [-1],
    "num_subjects": 20,
    "fewshot_subject": [-1],
    "num_fewshot": 10,
    "prior_maps_dir": "prior_maps_uniform.npy",
    "coco_anno_dir": "coco_annotations/",
    "backbone_config": "data/resnet50.yaml",
    "pixel_decoder": "MSD",
    "use_foveal_map": false,
    "gt_det_map_scale": 1,
    "out_of_subject_eval": false,
    "blur_slope": 0.2,
    "cortical_magnify": false,
    "cover_ratio": 0.5,
    "multi_scale_input": false,
    "matchness_prediction": false,
    "saliency_pred": false,
    "target_map_pred": false,
    "include_freeview": false,
    "exclude_wrong_trials": false,
    "pad_idx": 0,
    "eos_idx": 1,
    "discretize_fix": false,
    "target_fix_map_sigma": 16,
    "remove_return_fixations": false,
    "special_symbols": ["<pad>"]
  },
  "Train": {
    "train_backbone": false,
    "train_pixel_decoder": true,
    "use_dino_pretrained_model": false,
    "dropout": 0.0,
    "losses": ["subject_id_pred", "triplet_loss"],
    "lr_steps": [40, 80],
    "use_focal_loss": true,
    "subject_id_pred_weight": 1.0,
    "triplet_loss": 1.0,
    "batch_size": 16,
    "n_workers": 0,
    "repr": "FFN",
    "parallel": false,
    "log_dir": "assets/Air-D-useremb",
    "adam_lr": 1e-4,
    "adam_betas": [0.9, 0.999],
    "print_every": 200,
    "checkpoint_every": 4000,
    "evaluate_every": 4000,
    "max_iters": 15000
  },
  "Model": {
    "name": "HAT",
    "embedding_dim": 384,
    "n_heads": 4,
    "n_dec_layers": 6,
    "n_enc_layers": 3,
    "hidden_dim": 512,
    "num_output_layers": 3,
    "checkpoint": ""
  }
}
